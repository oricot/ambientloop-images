#!/usr/bin/env bash
# Descend UN fichier de poids dans ComfyUI, à la construction de l'image d'un service (25/10, PA55.3).
#
#     descendre-poids <adresse> <dossier de models/> <sha256>
#
# Comme l'installeur de la carte : aria2c en seize connexions, un .part puis le renommage, et l'empreinte
# contrôlée contre celle que Hugging Face publie (l'oid LFS), relevée à la main dans le Dockerfile. Une
# empreinte fausse fait échouer la construction : rien de ce qui n'a pas été vérifié n'entre dans l'image.
set -euo pipefail
ADRESSE="$1"; DOSSIER="$2"; ATTENDUE="$3"
NOM=$(basename "${ADRESSE%%\?*}")
CIBLE="/opt/ComfyUI/models/$DOSSIER"
mkdir -p "$CIBLE"
aria2c -q -x 16 -s 16 -k 64M --file-allocation=none --auto-file-renaming=false --allow-overwrite=true \
       -d "$CIBLE" -o "$NOM.part" "$ADRESSE"
rm -f "$CIBLE/$NOM.part.aria2"
LUE=$(sha256sum "$CIBLE/$NOM.part" | cut -d' ' -f1)
if [ "$LUE" != "$ATTENDUE" ]; then
    echo "descendre-poids : empreinte fausse pour $NOM ($LUE, attendu $ATTENDUE)" >&2
    rm -f "$CIBLE/$NOM.part"
    exit 1
fi
mv "$CIBLE/$NOM.part" "$CIBLE/$NOM"
printf '%s/%s %s\n' "$DOSSIER" "$NOM" "$LUE" >> /opt/IMAGE
echo "posé : $DOSSIER/$NOM ($(du -h "$CIBLE/$NOM" | cut -f1))"
